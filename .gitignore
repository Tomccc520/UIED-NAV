# 系统文件
.DS_Store
.vscode/
.idea/

# 依赖
node_modules/

# 环境变量
.env
.env.local
.env.production

# 日志
*.log
npm-debug.log*

# 数据库
*.db
*.db-journal
*.db.backup*

# 构建产物
dist/
build/
release/

# 上传文件
backend/uploads/*
!backend/uploads/.gitkeep

# 导出文件
backend/exports/*
!backend/exports/.gitkeep

# 子项目的 Git 目录（避免嵌套仓库）
backend/.git/
admin/.git/

# 测试覆盖率
coverage/

# Kiro 配置和文档（仅放行 API 对接文档）
.kiro/
**/docs/
!/docs/
/docs/*
!/docs/API/
!/docs/API/**
/docs/API/reports/*.json

# 开发工具脚本
add_copyright.py

# 模块安装临时目录
server/.module_backup/
server/.module_report/

# Egg 运行时/生成文件
server/server/run/
server/server/typings/
