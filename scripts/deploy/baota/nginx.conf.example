# UIED 导航系统 Nginx 配置模板（宝塔）
# 使用方式：
# 1. 将 __DOMAIN__ 替换为你的真实域名
# 2. 将 __SITE_ROOT__ 替换为你的站点目录（例如 /www/wwwroot/hao.uied.cn）
# 3. 将内容粘贴到宝塔对应站点的 Nginx 配置

server {
    listen 80;
    listen 443 ssl http2;
    server_name __DOMAIN__ www.__DOMAIN__;

    # 宝塔 SSL 证书配置由面板生成，这里保留占位
    # ssl_certificate     /www/server/panel/vhost/cert/__DOMAIN__/fullchain.pem;
    # ssl_certificate_key /www/server/panel/vhost/cert/__DOMAIN__/privkey.pem;

    # 上传限制
    client_max_body_size 100m;

    # 安全：禁止访问隐藏文件
    location ~ /\.(?!well-known).* {
        deny all;
    }

    # 后端 API（Egg.js）
    location /api {
        proxy_pass http://127.0.0.1:8002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }

    # 管理后台入口（Vue）
    location = /admin {
        return 301 /admin/;
    }

    location ^~ /admin/ {
        alias __SITE_ROOT__/admin/;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }

    # 官网前台（React）
    location / {
        root __SITE_ROOT__/frontend;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # 静态资源缓存
    location ~* \.(?:css|js|jpg|jpeg|png|gif|ico|svg|webp|woff|woff2)$ {
        expires 30d;
        access_log off;
        add_header Cache-Control "public";
    }

    access_log /www/wwwlogs/__DOMAIN__.log;
    error_log /www/wwwlogs/__DOMAIN__.error.log;
}

