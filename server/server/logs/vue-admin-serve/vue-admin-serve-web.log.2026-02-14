       FROM uied_hot_recommendation hr
       LEFT JOIN uied_website w ON hr.url = w.url AND w.is_delete = 0
       WHERE hr.is_delete = 0 AND hr.is_show = 1
       ORDER BY hr.sort ASC, hr.id DESC
       LIMIT 100
