2026-02-23 12:41:28,288 INFO 35570 [egg-sequelize](4ms) Executed (default): SELECT w.id, w.name, w.slug, w.url, w.icon_url AS iconUrl, w.description, w.click_count AS clickCount,
              w.create_time AS createTime, c.name AS category,
              ROUND(
                (w.click_count / GREATEST(1, LEAST(7, FLOOR((UNIX_TIMESTAMP() - w.create_time) / 86400) + 1)))
                + IF(w.is_new = 1, 50, 0)
              , 2) AS score
       FROM uied_website w
       LEFT JOIN uied_category c ON c.id = w.category_id
       WHERE w.is_delete = 0
       ORDER BY score DESC, w.click_count DESC, w.update_time DESC, w.id DESC
       LIMIT 20
